// ---------------------------------------------------------------------------
// Task 3 - Persistent Data Layer
// PostgreSQL schema for the Users / Projects / Tasks API.
//
// Every rule that protects data integrity lives HERE (or in
// prisma/constraints.sql), not only in the application layer:
//   - NOT NULL / UNIQUE / length limits  -> column definitions below
//   - allowed values                     -> native Postgres enum types
//   - referential integrity              -> foreign keys with explicit
//                                           onDelete behaviour
//   - business rules (non-empty strings, -> CHECK constraints, see
//     sane dates, no self-blocking)         prisma/constraints.sql
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Read from the environment at runtime. The connection string, including
  // the password, never appears in source control.
  url      = env("DATABASE_URL")
}

// --------------------------------- enums -----------------------------------
// These become real Postgres ENUM types, so an invalid value is rejected by
// the database even if a bad INSERT bypasses the API.

enum UserRole {
  ADMIN
  MANAGER
  MEMBER

  @@map("user_role")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

enum MemberRole {
  OWNER
  MAINTAINER
  CONTRIBUTOR
  VIEWER

  @@map("member_role")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

// --------------------------------- User ------------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  fullName  String   @map("full_name") @db.VarChar(120)
  role      UserRole @default(MEMBER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // 1-to-many: a user owns many projects.
  // Deleting a user cascades to the projects they own (and, through
  // Project, to those projects' tasks).
  ownedProjects Project[] @relation("ProjectOwner")

  // many-to-many through an explicit join model, so membership can carry
  // its own role and joined-at timestamp.
  memberships ProjectMember[]

  // 1-to-many: tasks assigned to this user. The FK is nullable and set to
  // NULL on delete, so removing a user never destroys task history.
  assignedTasks Task[] @relation("TaskAssignee")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// -------------------------------- Project ----------------------------------

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(2000)
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  ownerId     String        @map("owner_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  members ProjectMember[]
  tasks   Task[]

  // A single owner cannot have two projects with the same name.
  @@unique([ownerId, name], name: "project_owner_name_unique")
  @@index([status])
  @@index([ownerId])
  @@map("projects")
}

// ----------------------------- ProjectMember -------------------------------
// Explicit join table for the User <-> Project many-to-many relation.

model ProjectMember {
  projectId String     @map("project_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole @default(CONTRIBUTOR)
  joinedAt  DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Composite primary key: a user can appear on a project exactly once.
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// --------------------------------- Task ------------------------------------

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.VarChar(4000)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(3)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)

  // Required parent. A task cannot exist without a project.
  projectId String @map("project_id") @db.Uuid

  // Optional assignee. Nullable FK + SetNull keeps the task alive when the
  // assigned user is deleted.
  assigneeId String? @map("assignee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Task titles are unique within a project.
  @@unique([projectId, title], name: "task_project_title_unique")
  @@index([status])
  @@index([assigneeId])
  @@index([projectId, status])
  @@map("tasks")
}
